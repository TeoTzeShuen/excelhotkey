    {
      "keys": "HBD",
      "label": "Top and Bottom Border",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nrepeat with e in {edge top, edge bottom}\nset b to get border selection which border e\nset line style of b to continuous\nset weight of b to border weight thin\nend repeat\nend tell"
      }
    },
    {
      "keys": "HBC",
      "label": "Top and Thick Bottom Border",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nset bt to get border selection which border edge top\nset line style of bt to continuous\nset weight of bt to border weight thin\nset bb to get border selection which border edge bottom\nset line style of bb to continuous\nset weight of bb to border weight thick\nend tell"
