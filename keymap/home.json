      "keys": "HBO",
      "label": "Bottom Border",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nset b to get border selection which border edge bottom\nset line style of b to continuous\nset weight of b to border weight thin\nend tell"
      }
    },
    {
      "keys": "HBP",
      "label": "Top Border",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nset b to get border selection which border edge top\nset line style of b to continuous\nset weight of b to border weight thin\nend tell"
      }
    },
    {
      "keys": "HBL",
      "label": "Left Border",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nset b to get border selection which border edge left\nset line style of b to continuous\nset weight of b to border weight thin\nend tell"
      }
    },
    {
      "keys": "HBR",
      "label": "Right Border",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nset b to get border selection which border edge right\nset line style of b to continuous\nset weight of b to border weight thin\nend tell"
      }
    },
    {
      "keys": "HBN",
      "label": "No Border",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nrepeat with e in {edge left, edge right, edge top, edge bottom, inside vertical, inside horizontal, diagonal down, diagonal up}\ntry\nset line style of (get border selection which border e) to line style none\nend try\nend repeat\nend tell"
      }
    },
    {
      "keys": "HBA",
      "label": "All Borders",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nrepeat with e in {edge left, edge right, edge top, edge bottom, inside vertical, inside horizontal}\ntry\nset b to get border selection which border e\nset line style of b to continuous\nset weight of b to border weight thin\nend try\nend repeat\nend tell"
      }
    },
    {
      "keys": "HBS",
      "label": "Outside Borders",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nrepeat with e in {edge left, edge right, edge top, edge bottom}\nset b to get border selection which border e\nset line style of b to continuous\nset weight of b to border weight thin\nend repeat\nend tell"
      }
    },
    {
      "keys": "HBT",
      "label": "Thick Outside Borders",
      "action": {
        "applescript": "tell application \"Microsoft Excel\"\nrepeat with e in {edge left, edge right, edge top, edge bottom}\nset b to get border selection which border e\nset line style of b to continuous\nset weight of b to border weight thick\nend repeat\nend tell"
      }
    },
    {
      "keys": "HBB",
      "label": "Bottom Double Border",
